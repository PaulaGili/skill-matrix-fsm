{
  "name": "opusm-skill-management-assessment",
  "version": "0.1.0",
  "private": true,
  "description": "opusm developer assessment: skill matrix and certificate management on SAP Field Service Management.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "gate": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && node scripts/ci/check-bundle.mjs && npm run e2e",
    "check:fsm": "node --env-file=.env.local scripts/check-connection.mjs",
    "mcp": "tsx --env-file=.env.local mcp/server.ts",
    "eval:ai": "tsx --env-file=.env.local tests/ai-eval/run.ts",
    "smoke": "tsx --env-file=.env.local tests/fsm-smoke.ts",
    "seed": "tsx --env-file=.env.local scripts/fsm/seed.ts",
    "cleanup": "tsx --env-file=.env.local scripts/fsm/cleanup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@ui5/webcomponents": "2.27.2",
    "@ui5/webcomponents-base": "2.27.2",
    "@ui5/webcomponents-fiori": "2.27.2",
    "@ui5/webcomponents-icons": "2.27.2",
    "@ui5/webcomponents-react": "2.27.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  }
}
